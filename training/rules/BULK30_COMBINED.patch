+/// E04 numeric type count: both bits of a dual-type minion count; each living
+/// physical ALL minion adds one. This is not an assignment of distinct bodies
+/// to types (`one_minion_per_type`); it never consumes random choices.
+/// Working authority: user E04 contract, races.py::count_distinct_types.
+fn numeric_type_count(c: &Ctx, side: Side) -> i32 {
+    let mut types = Races::NONE;
+    let mut all = 0;
+    for m in c.boards[side].iter().filter(|m| m.alive()) {
+        if m.races == Races::ALL {
+            all += 1;
+        } else {
+            types = types.union(m.races);
+        }
+    }
+    types.0.count_ones() as i32 + all
+}
+
