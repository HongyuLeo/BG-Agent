+    let Some((side, _)) = c.locate(target) else { return };
+    if side != me.side { return; }
+    let Some((a, h)) = c.minion(target).filter(|m| m.alive()).map(|m| (m.atk, m.hp)) else { return };
+    // Use the same current-stat doubling as the existing Rat in a Cage/Ultralisk effects.
+    c.buff(target, a, h);
+    let Some((side, pos)) = c.locate(target) else { return };
+    if side != me.side { return; }
+    let minion = c.boards[side].remove(pos);
+    // Like Maiev, a locked arrival must not triple before its lock is applied.
+    let prior = std::mem::replace(&mut c.no_triples, true);
+    let hid = c.add_to_hand(side, Item::Minion(minion));
+    if let Some(hid) = hid
+        && let Some(h) = c.player(side).and_then(|p| p.hand.iter_mut().find(|h| h.hid == hid))
+    {
+        h.locked = 1;
+    }
+    c.no_triples = prior;
+}
