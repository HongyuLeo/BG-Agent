diff --git a/crates/taverngym/tests/maxwell_routes.rs b/crates/taverngym/tests/maxwell_routes.rs
new file mode 100644
index 0000000..2542435
--- /dev/null
+++ b/crates/taverngym/tests/maxwell_routes.rs
@@ -0,0 +1,27 @@
+//! Evidence for named frozen native routes only, not universal reachability proof.
+use taverngym::{Action,Game,RulesConfig};
+use taverngym::cards::{cid,db};
+use taverngym::state::Pending;
+
+#[test]fn frozen_shared_pools_and_real_finley_menu_do_not_offer_azshara() {
+    let ambition=cid("BG22_HERO_007p");let conquest=cid("BG22_HERO_007p2");let buddy=cid("BG22_HERO_007_Buddy");
+    // Exhaust the full metadata producer roots, before any lobby-type filtering.
+    let hero_roots:Vec<_>=db().iter().filter(|c|c.pools.hero).collect();assert!(!hero_roots.is_empty());
+    for h in &hero_roots {assert_ne!(h.hero_power,Some(ambition));assert_ne!(h.hero_power,Some(conquest));assert_ne!(h.buddy,Some(buddy));}
+    let finley=hero_roots.iter().find(|h|h.hero_power==Some(cid("TB_BaconShop_HP_057"))).expect("Finley remains in original hero pool").cid;
+    let (seed,mut g,n)=(0..1024).find_map(|seed| {
+        let g=Game::new(seed,RulesConfig{num_players:2,..RulesConfig::default()});
+        let Some(Pending::HeroSelect{options})=g.players[0].pending.last() else {return None};
+        options.iter().position(|c|*c==finley).map(|n|(seed,g,n))
+    }).expect("unmodified natural hero offers contain Finley in bounded search");
+    assert!(g.cfg.hero_pool.is_empty());assert!(g.cfg.hero_bans.is_empty());
+    g.apply(0,Action::Choose(n)).unwrap();g.apply(1,Action::Choose(0)).unwrap();
+    let all=taverngym::content::hero_power_pool(&g);
+    assert!(!all.contains(&ambition));assert!(!all.contains(&conquest));
+    // Buddy-pool implementation is private; its absent root is checked above.
+    // Do not expose a production API solely for this evidence fixture.
+    let Some(Pending::HeroPowerChoice{options,slot})=g.players[0].pending.last() else {panic!("real Finley discovery menu")};
+    assert_eq!(*slot,0);assert_eq!(options.len(),3);assert!(options.iter().all(|c|all.contains(c)));let selected=options[0];
+    println!("natural Finley seed={seed}; full hero metadata roots={}; lobby power candidates={}; menu={:?}",hero_roots.len(),all.len(),options.iter().map(|c|&db().get(*c).id).collect::<Vec<_>>());
+    g.apply(0,Action::Choose(0)).unwrap();assert_eq!(g.players[0].hero_power(),Some(selected));
+}
diff --git a/crates/taverngym/tests/numeric_e04.rs b/crates/taverngym/tests/numeric_e04.rs
new file mode 100644
index 0000000..074b7f6
--- /dev/null
+++ b/crates/taverngym/tests/numeric_e04.rs
@@ -0,0 +1,19 @@
+use taverngym::{Game,RulesConfig};
+use taverngym::cards::cid;
+use taverngym::actions::Action;
+use taverngym::script::{script,Me};
+use taverngym::types::Races;
+use taverngym::state::{Minion,Item};
+fn game(masks:&[Races])->Game{let mut g=Game::new(719,RulesConfig{num_players:2,lesser_trinket_turn:0,greater_trinket_turn:0,timewarp_enabled:false,record_log:false,..RulesConfig::default()});for p in 0..2{g.apply(p,Action::Choose(0)).unwrap();}for p in &mut g.players{p.board.clear();p.hand.clear();p.shop.clear();p.powers.clear();p.rewards.clear();p.quests.clear();p.effects.clear();p.trinkets.clear();p.pending.clear();p.gold=30;p.health=100;p.armor=0;p.tier=6;}
+for r in masks{let mut m=Minion::new(g.alloc_eid(),cid("BG25_001"));m.races=*r;m.set_stats(2,6);g.players[0].board.push(m);}g}
+fn me(id:&str)->Me{Me{side:0,eid:0,card:cid(id),golden:false,opt:0,pos:0,data:0}}
+fn cases()->Vec<(Vec<Races>,i32)>{vec![(vec![Races::QUILBOAR.union(Races::UNDEAD)],2),(vec![Races::QUILBOAR,Races::QUILBOAR],1),(vec![Races::ALL],1),(vec![Races::ALL,Races::ALL],2),(vec![Races::QUILBOAR.union(Races::UNDEAD),Races::ALL],3),(vec![Races::NONE],0),(vec![],0)]}
+#[test]fn crystal_numeric_dual_all_duplicate_typeless_boundaries(){for(masks,n)in cases(){let mut g=game(&masks);let rng=serde_json::to_string(&g.rng).unwrap();g.with_recruit(0,|c|{script(cid("BG36_MagicItem_220")).unwrap().start_of_turn.unwrap()(c,me("BG36_MagicItem_220"));});assert_eq!(g.players[0].gold,30+n,"{masks:?}");assert_eq!(serde_json::to_string(&g.rng).unwrap(),rng,"numeric type count must not draw RNG");}}
+#[test]fn mayhem_numeric_actual_endturn_boundary(){for(masks,n)in cases(){let mut g=game(&masks);g.players[0].rewards.push(cid("BG24_Reward_331"));g.apply(0,Action::EndTurn).unwrap();for m in &g.players[0].board{assert_eq!((m.atk,m.max_hp),(2+n,6+n),"{masks:?}");}}}
+#[test]fn tableware_numeric_actual_spell_play_boundary(){for(masks,n)in cases(){let mut g=game(&masks);g.with_recruit(0,|c|{c.add_to_hand(0,Item::spell(cid("BG34_272")));});g.apply(0,Action::Play{hand:0,pos:0}).unwrap();for m in &g.players[0].board{assert_eq!((m.atk,m.max_hp),(2+3*(1+n),6+3*(1+n)),"{masks:?}");}}}
+#[test]fn crystal_real_next_turn_base4_plus_dual2_exact_raw_restore(){let mut g=game(&[Races::QUILBOAR.union(Races::UNDEAD)]);g.players[0].trinkets.push(cid("BG36_MagicItem_220"));let raw=serde_json::to_string(&g).unwrap();let mut restored:Game=serde_json::from_str(&raw).unwrap();let mut cloned=g.clone();for x in [&mut g,&mut restored,&mut cloned]{x.apply(0,Action::EndTurn).unwrap();x.apply(1,Action::EndTurn).unwrap();assert_eq!(x.turn,2);assert_eq!(x.players[0].gold,6);assert_eq!(x.players[1].gold,4);}assert_eq!(serde_json::to_string(&g).unwrap(),serde_json::to_string(&restored).unwrap());assert_eq!(serde_json::to_string(&g).unwrap(),serde_json::to_string(&cloned).unwrap());}
+#[test]fn numeric_dead_and_opponent_isolation(){let mut g=game(&[Races::QUILBOAR]);let mut dead=Minion::new(g.alloc_eid(),cid("BG25_001"));dead.races=Races::UNDEAD.union(Races::DRAGON);dead.hp=0;g.players[0].board.push(dead);let mut other=Minion::new(g.alloc_eid(),cid("BG25_001"));other.races=Races::ALL;g.players[1].board.push(other);let opp=serde_json::to_string(&g.players[1]).unwrap();g.with_recruit(0,|c|script(cid("BG36_MagicItem_220")).unwrap().start_of_turn.unwrap()(c,me("BG36_MagicItem_220")));assert_eq!(g.players[0].gold,31);assert_eq!(serde_json::to_string(&g.players[1]).unwrap(),opp);}
+#[test]fn buddy_entity_assignment_threshold_is_unchanged(){let mut g=game(&[Races::QUILBOAR.union(Races::UNDEAD),Races::DRAGON.union(Races::BEAST)]);g.with_recruit(0,|c|{assert_eq!(taverngym::content::distinct_type_count(c,0),2);assert_eq!(taverngym::content::one_minion_per_type(c,0,|_|true).len(),2);});}
+#[test]fn numeric_union_plus_each_all_has_no_new_type_or_entity_cap(){let masks=[Races::QUILBOAR.union(Races::UNDEAD),Races::BEAST.union(Races::DRAGON),Races::ELEMENTAL.union(Races::MECH),Races::MURLOC.union(Races::PIRATE),Races::DEMON.union(Races::ABERRATION),Races::ALL,Races::ALL];let mut g=game(&masks);g.with_recruit(0,|c|script(cid("BG36_MagicItem_220")).unwrap().start_of_turn.unwrap()(c,me("BG36_MagicItem_220")));assert_eq!(g.players[0].gold,42,"F count_distinct_types has no cap: ten union bits plus two physical All");}
